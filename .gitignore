# Live settings: written by install.php, never the same on two servers.
platform/config/config.php

# Build output. Reproduce it with platform/build-zip.sh — do not commit the zip itself,
# it is 8 MB and changes on every build.
platform/dist/
*.zip

# What visitors upload, and the share pictures made from it. Never part of the code.
platform/public/assets/uploads/
platform/storage/drive/

# Guests' face photos for entry passes, and photos waiting to go to storage. People's data, not code.
platform/storage/
